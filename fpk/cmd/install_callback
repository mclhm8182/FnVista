#!/bin/bash
# 安装：部署脚本 -> 写定时任务 -> 可选立即应用
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-fnos-bing-wallpaper}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
LOG="${TRIM_TEMP_LOGFILE:-/tmp/fnos-bing-wallpaper-install.log}"

SBIN_DIR="/usr/local/sbin"
DAILY_BIN="$SBIN_DIR/bing-wallpaper-daily.sh"
SET_BIN="$SBIN_DIR/fnos-wallpaper-set.sh"
WATCHDOG_BIN="$SBIN_DIR/fnos-wallpaper-watchdog.sh"
ZIPPATCH_BIN="$SBIN_DIR/fnos-www-zip-patch.sh"
ROTATE_BIN="$SBIN_DIR/fnos-wallpaper-rotate.sh"
CRON_UPDATE_BIN="$SBIN_DIR/fnos-cron-update.sh"
CRON_FILE="/etc/cron.d/fnos-bing-wallpaper"
DATA_DIR="/var/lib/fnos-wallpaper"
STATE_DIR="$DATA_DIR"
LOG_FILE="/var/log/fnos-bing-wallpaper.log"

err() { echo "[$(date '+%F %T')] [install_callback] $*" >> "$LOG"; }
ok()  { echo "[$(date '+%F %T')] [install_callback] $*" >> "$LOG"; }

# ---------- 1. 环境兜底检查（升级/重装时 init 不一定拦截） ----------
[ -d /usr/trim/www/static/bg ] || { err "未找到 /usr/trim/www/static/bg，请确认这是飞牛 fnOS 系统"; exit 1; }
command -v ffmpeg >/dev/null 2>&1 || { err "缺少 ffmpeg，无法转码壁纸"; exit 1; }

# ---------- 3. 部署脚本 ----------
[ -f "$APP_DIR/bing-wallpaper-daily.sh" ]    || { err "包内缺少 bing-wallpaper-daily.sh ($APP_DIR)"; exit 1; }
[ -f "$APP_DIR/fnos-wallpaper-set.sh" ]      || { err "包内缺少 fnos-wallpaper-set.sh ($APP_DIR)"; exit 1; }
[ -f "$APP_DIR/fnos-cron-update.sh" ]        || { err "包内缺少 fnos-cron-update.sh ($APP_DIR)"; exit 1; }

install -m 755 "$APP_DIR/bing-wallpaper-daily.sh"    "$DAILY_BIN"       || { err "部署 $DAILY_BIN 失败"; exit 1; }
install -m 755 "$APP_DIR/fnos-wallpaper-set.sh"      "$SET_BIN"         || { err "部署 $SET_BIN 失败"; exit 1; }
install -m 755 "$APP_DIR/fnos-wallpaper-watchdog.sh" "$WATCHDOG_BIN"    || { err "部署 $WATCHDOG_BIN 失败"; exit 1; }
install -m 755 "$APP_DIR/fnos-cron-update.sh"        "$CRON_UPDATE_BIN" || { err "部署 $CRON_UPDATE_BIN 失败"; exit 1; }
if [ -f "$APP_DIR/fnos-wallpaper-rotate.sh" ]; then
  install -m 755 "$APP_DIR/fnos-wallpaper-rotate.sh" "$ROTATE_BIN" || err "部署 $ROTATE_BIN 失败（轮播不可用）"
fi
if [ -f "$APP_DIR/fnos-www-zip-patch.sh" ]; then
  install -m 755 "$APP_DIR/fnos-www-zip-patch.sh" "$ZIPPATCH_BIN" || err "部署 $ZIPPATCH_BIN 失败（远程登录页壁纸将无法修复）"
  # 立即修补还原源 www.zip（去 CDN 前缀 + 注入 CSS），失败不阻断安装
  bash "$ZIPPATCH_BIN" --check || err "www.zip 修补未完成（可能 fnOS 版本形态变化）"
  ok "www.zip 前端补丁已应用"
fi
# 升级/异常存活自检脚本（恢复 cron 与轮播守护进程）
if [ -f "$APP_DIR/fnos-survival-check.sh" ]; then
  install -m 755 "$APP_DIR/fnos-survival-check.sh" "/usr/local/sbin/fnos-survival-check.sh" || err "部署 fnos-survival-check.sh 失败"
fi
ok "脚本已部署到 $SBIN_DIR"

# ---------- 4. 记录默认设置（升级/重装时保留用户已有设置，不覆盖） ----------
mkdir -p "$STATE_DIR" 2>/dev/null
# 更换时间：已有则保留，否则默认 07:00
if [ ! -s "$STATE_DIR/run_time" ]; then
  printf '07:00' > "$STATE_DIR/run_time" 2>/dev/null
fi
# 历史壁纸：已有则保留，否则默认 7 天留存（配合缩略图选用与轮播）
if [ ! -s "$STATE_DIR/keep_history" ]; then
  printf '7\n' > "$STATE_DIR/keep_history" 2>/dev/null
fi
# 轮播开关：默认关闭（可在设置页开启）
if [ ! -f "$STATE_DIR/rotate" ]; then
  printf '0\n' > "$STATE_DIR/rotate" 2>/dev/null
fi
RUN_TIME="$(cat "$STATE_DIR/run_time" 2>/dev/null)"

# v1.5.5: 旧版 db_wp_backup 只有 uid|wpid 两列，缺壁纸类型。趁数据库还没被
# 本应用改动，补全为四列，确保「恢复系统原始壁纸」能还原用户原本的动态壁纸模式。
if [ -s "$STATE_DIR/db_wp_backup" ] \
   && ! awk -F'|' 'NF>=4{ok=1} END{exit !ok}' "$STATE_DIR/db_wp_backup" 2>/dev/null; then
  if su postgres -c "psql -d trim_sac -t -A -F'|' -c 'select user_id, coalesce(single_photo_wp_id,0), coalesce(wallpaper_type,100), coalesce(dynamic_wp_id,0) from user_preference;'" \
       > "$STATE_DIR/db_wp_backup.v155" 2>/dev/null \
     && [ -s "$STATE_DIR/db_wp_backup.v155" ]; then
    mv -f "$STATE_DIR/db_wp_backup.v155" "$STATE_DIR/db_wp_backup"
    ok "已升级桌面壁纸类型备份（含 wallpaper_type）"
  else
    rm -f "$STATE_DIR/db_wp_backup.v155"
  fi
fi

# ---------- 5. 统一重建定时任务（每日更换 + 看门狗 + 可选轮播） ----------
if bash "$CRON_UPDATE_BIN"; then
  ok "定时任务已重建：每天 $RUN_TIME（轮播$([ "$(cat "$STATE_DIR/rotate" 2>/dev/null)" = "1" ] && echo 开 || echo 关)）"
else
  err "fnos-cron-update.sh 执行失败"
fi

# ---------- 5b. 升级/异常存活自检（恢复 cron 与轮播守护进程，开机/升级自校） ----------
if [ -x "/usr/local/sbin/fnos-survival-check.sh" ]; then
  bash "/usr/local/sbin/fnos-survival-check.sh" || true
  ok "存活自检已执行"
fi

# ---------- 6. 立即应用（安装完换一次；失败自动重试一次） ----------
# 注：第 3 步的 www.zip 补丁会触发系统完整性守护秒级重建 /usr/trim/www，
#     首次 --force 可能撞上重建窗口（"目录不存在"），等待后重试即可。
if ! bash "$DAILY_BIN" --force >> "$LOG" 2>&1; then
  sleep 8
  if bash "$DAILY_BIN" --force >> "$LOG" 2>&1; then
    ok "已立即应用今日壁纸（重试成功）"
  else
    # 不让安装失败：常见原因是设备暂时无法访问 cn.bing.com
    err "首次更换壁纸失败（多为网络原因），可稍后手动执行: sudo $DAILY_BIN --force"
  fi
else
  ok "已立即应用今日壁纸"
fi

exit 0
